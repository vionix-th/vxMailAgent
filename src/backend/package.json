{
  "name": "vxmailagent-backend",
  "version": "0.1.0",
  "main": "index.ts",
  "type": "commonjs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-testdata": "npx ts-node generate-testdata.ts",
    "dev": "ts-node index.ts",
    "start": "node dist/backend/index.js",
    "prebuild": "npm run clean",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\" --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "node --test -r ts-node/register **/*.test.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "cookie": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "googleapis": "^155.0.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.38.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "pino-pretty": "^11.2.2"
  }
}
