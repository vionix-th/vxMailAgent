{
  "name": "vxmailagent-backend",
  "version": "0.1.0",
  "main": "index.ts",
  "type": "commonjs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-testdata": "npx ts-node generate-testdata.ts",
    "dev": "ts-node index.ts",
    "start": "node dist/index.js",
    "prebuild": "npm run clean",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "lint": "eslint \"**/*.ts\" --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "npm run test:hard",
    "test:unit": "DISABLE_DOTENV=true VX_TEST_MOCK_OPENAI=true TRACE_PERSIST=false npm run build && node --test --test-concurrency=1 \"tests/*unit.cjs\" \"tests/integration-test-config.cjs\"",
    "test:unit:compiled": "DISABLE_DOTENV=true VX_TEST_MOCK_OPENAI=true TRACE_PERSIST=false node --test --test-concurrency=1 \"tests/*unit.cjs\" \"tests/integration-test-config.cjs\"",
    "test:contract": "DISABLE_DOTENV=true VX_TEST_MOCK_OPENAI=true TRACE_PERSIST=false npm run build && node --test --test-concurrency=1 \"tests/orchestrator.contract.cjs\"",
    "test:contract:compiled": "DISABLE_DOTENV=true VX_TEST_MOCK_OPENAI=true TRACE_PERSIST=false node --test --test-concurrency=1 \"tests/orchestrator.contract.cjs\"",
    "test:hard": "DISABLE_DOTENV=true VX_TEST_MOCK_OPENAI=true TRACE_PERSIST=false TEST_HARD_TIMEOUT_MS=30000 node tests/run-all-tests.cjs",
    "test:live": "node --test \"tests/*live.cjs\"",
    "ci": "npm run check && npm run test:unit && npm run test:contract"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "cookie": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "googleapis": "^155.0.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.38.1",
    "openid-client": "^5.6.5",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "pino-pretty": "^11.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7"
  }
}
