{
  "name": "vxmailagent-backend",
  "version": "0.1.0",
  "main": "dist/backend/index.js",
  "type": "commonjs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "ts-node index.ts",
    "start": "node dist/backend/index.js",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "cp -R storage/sqlite/schema dist/backend/storage/sqlite/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "better-sqlite3": "^12.2.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "googleapis": "^155.0.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.38.1",
    "openid-client": "^5.6.5",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@typescript-eslint/utils": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "pino-pretty": "^11.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7"
  }
}
