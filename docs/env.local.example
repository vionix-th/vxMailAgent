# Required configuration
VX_MAILAGENT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=change-me-please-with-at-least-32-characters
JWT_EXPIRES_IN_SEC=86400
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://example.com/oauth/google/callback
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=https://example.com/oauth/outlook/callback

# Optional overrides
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
ENABLE_TEST_ROUTES=
TRACE_VERBOSE=
OPENAI_REQUEST_TIMEOUT_MS=30000
